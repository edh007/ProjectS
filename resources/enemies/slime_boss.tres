[gd_resource type="Resource" script_class="EnemyData" format=3]

[ext_resource type="Script" path="res://resources/enemy_data.gd" id="1_ed"]
[ext_resource type="Script" path="res://resources/enemy_move.gd" id="2_em"]

[sub_resource type="Resource" script_class="EnemyMove" id="move_1"]
script = ExtResource("2_em")
