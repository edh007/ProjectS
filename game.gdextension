[configuration]
entry_symbol = "game_library_init"
compatibility_minimum = "4.4"

[libraries]
linux.debug.x86_64 = "res://bin/libgame_gdextension.so"
linux.release.x86_64 = "res://bin/libgame_gdextension.so"
windows.debug.x86_64 = "res://bin/game_gdextension.dll"
windows.release.x86_64 = "res://bin/game_gdextension.dll"
